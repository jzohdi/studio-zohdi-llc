{
	"name": "studio-zohdi",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.17.0",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"video:dev": "npm --prefix remotion run dev",
		"video:compositions": "npm --prefix remotion run compositions",
		"video:render": "npm --prefix remotion run render --",
		"video:publish": "node scripts/publish-project-preview.mjs",
		"carousel:publish": "node scripts/publish-project-preview-carousel.mjs",
		"og:generate": "node scripts/generate-og-image.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-vercel": "^6.3.5",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"@types/three": "^0.186.0",
		"@vitest/browser-playwright": "^5.1.0",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@fontsource-variable/league-spartan": "^5.3.0",
		"three": "^0.186.1",
		"three-globe": "^2.45.6"
	}
}
